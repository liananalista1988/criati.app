SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/criati_db
DB_USERNAME=criati_app
DB_PASSWORD=altere_aqui

# Bootstrap do primeiro Superadministrador (opcional).
# Só tem efeito se ainda NAO existir nenhum Superadministrador cadastrado no banco.
# Deixe em branco/remova apos o primeiro uso; nao ha valor padrao por seguranca.
CRIATI_BOOTSTRAP_NOME=
CRIATI_BOOTSTRAP_EMAIL=
CRIATI_BOOTSTRAP_PASSWORD=

# Expiracao de convites em horas (opcional; padrao 72 se nao informada).
CRIATI_CONVITE_EXPIRACAO_HORAS=

# Carga de dados de demonstracao (Clinica Vida Demo). Padrao false; NUNCA
# habilitar em producao. Use apenas em ambiente local/test.
CRIATI_DADOS_DEMO_HABILITADOS=false

# Limite de upload OFX em bytes (opcional; padrao 1 MiB).
CRIATI_IMPORTACAO_OFX_TAMANHO_MAXIMO_BYTES=1048576
